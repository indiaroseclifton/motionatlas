{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "site",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/atlas"
    },
    {
      "source": "/site/:id",
      "destination": "/api/site?id=:id"
    },
    {
      "source": "/site/:id/:path*",
      "destination": "/api/site?id=:id&path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/work/djinyc",
      "destination": "/work/djinyc/home",
      "permanent": false
    },
    {
      "source": "/work/djinyc/",
      "destination": "/work/djinyc/home",
      "permanent": false
    },
    {
      "source": "/work/01",
      "destination": "/work/01/hub",
      "permanent": false
    },
    {
      "source": "/work/01/",
      "destination": "/work/01/hub",
      "permanent": false
    },
    {
      "source": "/ds",
      "destination": "/ds/start",
      "permanent": false
    },
    {
      "source": "/ds/",
      "destination": "/ds/start",
      "permanent": false
    }
  ]
}
